###############################################
# Bambuddy - Example Environment Configuration
#
# Copy this file to `.env` and fill in real values.
# IMPORTANT: `.env` must NOT be committed (already in `.gitignore`).
###############################################

# Server
PORT=3000

# MongoDB (required for production)
# Example: mongodb+srv://<username>:<password>@<cluster>/<db>?retryWrites=true&w=majority
MONGODB_URI=

# Sessions
# Use a long random string in production.
SESSION_SECRET=

# Google OAuth (Sign in with Google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Google Places API (server-side calls in `src/services/locationService.js`)
GOOGLE_PLACES_API_KEY=

# Google Maps JavaScript API (used in browser via EJS templates)
GOOGLE_MAPS_API_KEY=

# reCAPTCHA v3
# Site key is public and loaded in the browser; secret key stays server-side.
reCAPTCHA_site_key=
reCAPTCHA_secret_key=

